# Sesja (min. 32 znaki). W trybie dev generuje się automatycznie.
NUXT_SESSION_PASSWORD=

# Logowanie przez Google: https://console.cloud.google.com/apis/credentials
# Adres zwrotny: <adres strony>/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Adresy e-mail (po przecinku), które po zalogowaniu dostają rolę administratora.
NUXT_ADMIN_EMAILS=

# Captcha Cloudflare Turnstile. Puste = captcha wyłączona (np. lokalnie).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Liczba własnych reverse proxy przed aplikacją (nginx = 1, Cloudflare + nginx = 2, bez proxy = 0).
# Od niej zależy, który adres z X-Forwarded-For liczy się do limitu wyszukiwarki.
NUXT_TRUSTED_PROXY_HOPS=1
NUXT_DB_PATH=.data/saintseiya.db
NUXT_UPLOADS_DIR=.data/uploads
